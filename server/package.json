{
  "name": "codeyoung-server",
  "version": "1.0.0",
  "description": "Backend foundation for Codeyoung trial class booking system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "prisma generate && esbuild src/server.ts --bundle --platform=node --format=esm --target=es2022 --packages=external --outfile=dist/server.js",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "esbuild": "^0.28.0",
    "prisma": "^6.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.2"
  }
}
