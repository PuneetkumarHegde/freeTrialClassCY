// Prisma schema for Codeyoung Trial-Class Booking

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARENT
  MENTOR
  ADMIN
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AttendanceStatus {
  SCHEDULED
  JOINED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum EmailRecipientType {
  PARENT
  MENTOR
  ADMIN
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  FAILED
  NOT_DELIVERED
}

enum NotificationType {
  NEW_TRIAL_BOOKING
  TRIAL_COMPLETED
  TRIAL_CANCELLED
  EMAIL_FAILED
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String?
  role         Role     @default(PARENT)
  timezone     String   @default("Asia/Kolkata")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mentor             Mentor?
  parentAppointments Appointment[]  @relation("ParentAppointments")
  notifications      Notification[] @relation("UserNotifications")

  @@index([email])
  @@index([role])
}

model Mentor {
  id        String   @id @default(uuid())
  userId    String   @unique
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability     MentorAvailability[]
  unavailabilities MentorUnavailability[]
  appointments     Appointment[]

  @@index([userId])
  @@index([isActive])
}

model MentorAvailability {
  id         String @id @default(uuid())
  mentorId   String
  dayOfWeek  Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  localStart String // HH:mm e.g. "17:00"
  localEnd   String // HH:mm e.g. "21:00"

  mentor Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([mentorId, dayOfWeek])
}

model MentorUnavailability {
  id        String   @id @default(uuid())
  mentorId  String
  startDate DateTime @db.Timestamptz(3)
  endDate   DateTime @db.Timestamptz(3)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentor Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([startDate, endDate])
}

model Appointment {
  id           String            @id @default(uuid())
  mentorId     String
  parentId     String
  studentName  String
  studentGrade String
  subject      String
  learningGoal String?
  startTime    DateTime          @db.Timestamptz(3)
  endTime      DateTime          @db.Timestamptz(3)
  status       AppointmentStatus @default(CONFIRMED)
  meetingLink  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  mentor        Mentor           @relation(fields: [mentorId], references: [id], onDelete: Restrict)
  parent        User             @relation("ParentAppointments", fields: [parentId], references: [id], onDelete: Restrict)
  attendance    TrialAttendance?
  emailLogs     EmailLog[]
  notifications Notification[]

  @@index([mentorId])
  @@index([parentId])
  @@index([startTime, endTime])
  @@index([status])
}

model TrialAttendance {
  id            String           @id @default(uuid())
  appointmentId String           @unique
  status        AttendanceStatus @default(SCHEDULED)
  joinedAt      DateTime?        @db.Timestamptz(3)
  leftAt        DateTime?        @db.Timestamptz(3)
  completedAt   DateTime?        @db.Timestamptz(3)
  mentorNotes   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([appointmentId])
}

model EmailLog {
  id                String              @id @default(uuid())
  appointmentId     String?
  recipientEmail    String
  recipientType     EmailRecipientType
  subject           String
  status            EmailDeliveryStatus @default(QUEUED)
  providerMessageId String?
  errorMessage      String?
  emailContent      String?             @db.Text
  sentAt            DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now())

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([recipientEmail])
  @@index([recipientType])
  @@index([status])
  @@index([appointmentId])
  @@index([createdAt])
}

model Notification {
  id              String           @id @default(uuid())
  type            NotificationType
  recipientUserId String?
  appointmentId   String?
  title           String
  message         String
  readAt          DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now())

  recipient   User?        @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([recipientUserId])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
}
